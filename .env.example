# ══════════════════════════════════════════════════════════════
# Aave V3 Liquidation Monitor v4 (Event-Driven) — .env
#
# Любую настройку можно задать отдельно для сети, добавив её имя
# префиксом: ARBITRUM_WS_RPC_URL, BASE_POOL_ADDRESS и т.д.
# Переменная без префикса работает как значение по умолчанию.
# ══════════════════════════════════════════════════════════════

# ── RPC — ОБЯЗАТЕЛЬНО ДВА РАЗНЫХ ────────────────────────────────
# WS_RPC_URL — именно WebSocket (wss://), не https://. Нужен для подписок.
WS_RPC_URL=wss://ethereum-sepolia-rpc.publicnode.com
# HTTP_RPC_URL — обычный https://, используется для Multicall-батчей
HTTP_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# ── Адреса контрактов Aave V3 (Sepolia) ─────────────────────────
POOL_ADDRESS=0x6Ae43d3271ff6888e7Fc43Fd7321a503ff738951
DATA_PROVIDER_ADDRESS=0x3e9708d80f7B3e43118013075F7e95CE3AB31F31
ORACLE_ADDRESS=0x2da88497588bf89281816106C7259e31AF45a663
# Канонический адрес Multicall3, одинаковый в 250+ сетях.
MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11

# ── Ваш контракт и роутеры ──────────────────────────────────────
LIQUIDATION_BOT_ADDRESS=
PRIVATE_KEY=
# Можно перечислить несколько роутеров через запятую — бот выберет
# тот, что даёт лучшую цену.
ROUTER_ADDRESSES=0xc532a74256d3db42d0bf7a0400fefdbad7694008
# Keep false until you explicitly want live txs. Observation/seed never need true.
AUTO_EXECUTE=false
# Stop a running monitor without hunting PIDs:
#   powershell -ExecutionPolicy Bypass -File tools\stop_monitor.ps1
# Seed borrower book (public RPC ok):
#   python tools/seed_borrowers.py --chains base,arbitrum --days 14

# Приватный релей для отправки транзакций (защита от фронтраннинга).
# ОБЯЗАТЕЛЕН при AUTO_EXECUTE=true — публичный mempool заблокирован.
PRIVATE_TX_RPC_URL=

# ── Ценовые фиды ────────────────────────────────────────────────
# По умолчанию агрегаторы Chainlink определяются автоматически через
# oracle.getSourceOfAsset() для каждого резерва — вписывать вручную не нужно.
DISCOVER_PRICE_FEEDS=true
# Ручное дополнение/переопределение. Формат: СИМВОЛ:адрес_агрегатора,...
PRICE_FEED_AGGREGATORS=

# ── SVR ─────────────────────────────────────────────────────────
# Резервы под SVR-защитой: открытая гонка по ним недоступна.
KNOWN_SVR_PROXY_ADDRESSES=
SKIP_SVR_RESERVES=true

# ── Порог принятия решений ──────────────────────────────────────
HEALTH_FACTOR_THRESHOLD=1.0
CLOSE_FACTOR_HF_THRESHOLD=0.95
MIN_BASE_MAX_CLOSE_FACTOR_THRESHOLD=200000000000
SLIPPAGE_TOLERANCE=0.02
MIN_PROFIT_TOKEN_UNITS=0
MIN_DEBT_BASE_THRESHOLD=0

# ── Безопасность исполнения ─────────────────────────────────────
# Полная симуляция (eth_call + estimate_gas) перед каждой отправкой.
# Выключать только для отладки.
SIMULATE_BEFORE_SEND=true
# Запас к оценённому лимиту газа
GAS_LIMIT_BUFFER=1.25
# Потолок цены газа в gwei; 0 — без ограничения
MAX_GAS_PRICE_GWEI=0
# Срок жизни swap-а внутри транзакции
SWAP_DEADLINE_SECONDS=120

# ── Устойчивость WebSocket ──────────────────────────────────────
# Задержка перед первым переподключением и её потолок (растёт вдвое + jitter)
WS_BACKOFF_INITIAL_SECONDS=1.0
WS_BACKOFF_MAX_SECONDS=60
# Сколько секунд тишины в канале до проверки живости соединения
WS_SILENCE_TIMEOUT_SECONDS=120
WS_CONNECT_TIMEOUT_SECONDS=20
WS_PING_INTERVAL_SECONDS=20
WS_PING_TIMEOUT_SECONDS=20
WS_REQUEST_TIMEOUT_SECONDS=30
# Строка «alive: ...» в логе — подтверждение, что процесс жив
HEARTBEAT_INTERVAL_SECONDS=60

# ── Транзакции в полёте ─────────────────────────────────────────
PUBLIC_TX_TIMEOUT_SECONDS=120
PRIVATE_TX_TIMEOUT_SECONDS=30
PENDING_CHECK_INTERVAL_SECONDS=3

# ── Telegram-алерты (необязательно) ─────────────────────────────
# Нужны оба значения, иначе алерты просто отключены.
# Aave monitor uses TELEGRAM_BOT_TOKEN (Irmanov_bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Morpho scanner/executor: separate bot when set. Empty = fall back to TELEGRAM_BOT_TOKEN.
# Chat stays TELEGRAM_CHAT_ID unless MORPHO_TELEGRAM_CHAT_ID is set.
MORPHO_TELEGRAM_BOT_TOKEN=
# MORPHO_TELEGRAM_CHAT_ID=

# ── Прочее ──────────────────────────────────────────────────────
STATE_FILE=monitor_state_v4.json
LOG_LEVEL=INFO

# ── Flash arbitrage (Этап 3) ───────────────────────────────────
# Нужны минимум два UniswapV2-совместимых роутера и (для execute) задеплоенный
# contracts/AaveV3FlashArbBot.sol. В dry-run достаточно роутеров + токенов.
# FLASH_ARB_ENABLED=false
# FLASH_ARB_BOT_ADDRESS=
# FLASH_ARB_TOKENS=USDC,WETH,USDT
# FLASH_ARB_AMOUNTS=USDC:1000000000,WETH:500000000000000000
# FLASH_ARB_MIN_PROFIT_BPS=10
# FLASH_ARB_SCAN_INTERVAL_SECONDS=30

# ── Balancer 0% flash + Uniswap V3 (Этап 3b) ───────────────────
# Убирает 5 bps Aave premium — обязательное условие для DEX-arb на L2.
# Контракт: contracts/BalancerV3FlashArbBot.sol (Vault 0xBA12…F2C8).
# BALANCER_ARB_ENABLED=false
# BALANCER_ARB_BOT_ADDRESS=
# BALANCER_ARB_TOKENS=USDC,WETH
# BALANCER_ARB_AMOUNTS=USDC:1000000000,WETH:500000000000000000
# BALANCER_ARB_MIN_PROFIT_BPS=5
# BALANCER_ARB_SCAN_INTERVAL_SECONDS=20

# ── Мультисеть (Этап 2) ─────────────────────────────────────────
# Перечислите сети — бот поднимет по отдельному OS-процессу на каждую
# (свой event loop, свой state-файл, свой лог). Пустое значение — одна сеть.
# CHAINS=base,arbitrum,optimism
#
# На каждую сеть нужны как минимум:
#   <NAME>_WS_RPC_URL, <NAME>_HTTP_RPC_URL,
#   <NAME>_POOL_ADDRESS, <NAME>_DATA_PROVIDER_ADDRESS, <NAME>_ORACLE_ADDRESS
# ARBITRUM_WS_RPC_URL=wss://...
# ARBITRUM_HTTP_RPC_URL=https://...
# ARBITRUM_POOL_ADDRESS=0x...
# BASE_WS_RPC_URL=wss://...
# OPTIMISM_WS_RPC_URL=wss://...

# ── Morpho Blue flash-liquidation (parallel to Aave; does not use AUTO_EXECUTE) ──
# Defaults are observe-only. Do not set MORPHO_AUTO_EXECUTE=true until paper
# has run 1–2 days on cascades. Live also needs MORPHO_MODE=live,
# MORPHO_LIVE_CONFIRM=YES_SEND_LIVE, and (for Base 8453) MORPHO_LIVE_MAINNET=true.
# Chain prefix works: BASE_MORPHO_MODE=paper
# Unprefixed MORPHO_LIQ_CONTRACT / MORPHO_OPERATOR_ADDRESS inherit on every chain;
# BASE_MORPHO_LIQ_CONTRACT overrides. Aave AUTO_EXECUTE is unrelated and must stay false.
#
# Observe tonight (repo root):
#   .venv-run\Scripts\python.exe morpho_research\morpho_scanner.py --chains base
# Optional bounded WS:  --duration-seconds 3600
# Omit or --duration-seconds 0 = forever until SIGINT (do not pass 1800 overnight).
# One-shot HTTP dry-run: --once --seed-per-market 50
#
# TEMPORARY diagnostic (NOT combat window 19.08). Does not set AUTO_EXECUTE.
#   .venv-run\Scripts\python.exe morpho_research\morpho_scanner.py --chains base --diagnostic-mode --min-net-profit-usd 0.05
# MORPHO_DIAGNOSTIC_MODE=0
# MIN_NET_PROFIT_USD=0.05
# MORPHO_MIN_NET_PROFIT_USD=0.05
# MORPHO_GAS_USD=          # optional conservative gas USD; else gasLimit * priority gwei * ETH/USD
# MORPHO_ETH_USD=          # optional ETH USD if Chainlink latestAnswer is unavailable
#
# MORPHO_MODE=observe
# MORPHO_AUTO_EXECUTE=false
# MORPHO_LIVE_CONFIRM=
# MORPHO_LIVE_MAINNET=false
# MORPHO_LIQ_CONTRACT=
# MORPHO_LIQ_CONTRACT_SEPOLIA=
# MORPHO_OPERATOR_ADDRESS=
# MORPHO_PRIVATE_KEY=
# MORPHO_EXECUTOR_ENABLED=true
# MORPHO_MIN_DEBT_USD=0
# MORPHO_MAX_DEBT_USD=25000
# 0 = no cap (analysis / temporary)
# MORPHO_MIN_EDGE_USD=0.5
# MORPHO_GAS_LIMIT=800000
# MORPHO_PRIORITY_FEE_GWEI=0.05
# MORPHO_PRIORITY_FEE_MAX_GWEI=3
# MORPHO_STORM_PRIORITY_GWEI=2.0
# MORPHO_STORM_SECONDS=15
# MORPHO_STORM_ORACLE_BPS=25
# MORPHO_MAX_INFLIGHT=6
# MORPHO_SOFT_BATCH_MAX=6
# MORPHO_HARD_BATCH_MAX=3
# MORPHO_PREENCODE_TTL_SECONDS=20
# MORPHO_GAS_BUMP_PCT=25
# MORPHO_GAS_BUMP_MAX=4
# MORPHO_STAGGER_MS=40
# MORPHO_SLIPPAGE_BPS=200
# MORPHO_V3_FEE=3000
# MORPHO_SWAP_DEADLINE_SECONDS=120
# MORPHO_LIQ_COOLDOWN_SECONDS=15
# After foreign Liquidate: block LIVE on that (market,user). Cleared if Multicall still sees borrow.
# MORPHO_DEAD_TTL_SECONDS=90
# MORPHO_HF_THRESHOLD=1.0
# Hourly executor snapshot to Telegram. 0 = off (alerts only on events).
# MORPHO_STATUS_TG_SECONDS=0
# Comma-separated market ids, USDC/cbXRP pairs, or collateral symbols.
# Empty = all enabled rows in morpho_research/morpho_markets.py for the chain.
# MORPHO_ALLOWED_MARKETS=USDC/cbXRP,USDC/cbADA,USDC/KTA,WETH/cbBTC,WETH/USDC,USDC/stkWELL
# Tail liquidations not on the watchlist: Telegram only, no seed, no live.
# MORPHO_DISCOVERY_TG=true
# MORPHO_DISCOVERY_MIN_DEBT_USD=300
# MORPHO_HOT_HF_THRESHOLD=1.08
# MORPHO_ORACLE_NEAR_HF=1.20
# MORPHO_ORACLE_POLL_SECONDS=1.0
# MORPHO_ORACLE_POLL_FAST_SECONDS=0.35
# MORPHO_ORACLE_FEED_WS=1
# MORPHO_ORACLE_PENDING_PRICE=1
# On large oracle Δ (bps), re-check ALL tracked borrowers on that market (cascade).
# MORPHO_ORACLE_STORM_WIDE_BPS=50
# Dust feeder watch (Aug24 pattern: B90→cbXRP→Borrow→liq ~30s). Default on.
# MORPHO_FEEDER_WATCH=1
# MORPHO_FEEDER_ADDRESSES=0xb90fe999be6869af0afc557dccfbe169ea3403d6,0x6c561b446416e1a00e8e93e221854d6ea4171372
# Keep empty feeder victims in hot this long (seconds); then drop. Cap 60.
# MORPHO_FEEDER_PIN_SECONDS=35
# Prebuild arm window after feeder Transfer (seconds). Borrow-fast / oracle-fast use this.
# MORPHO_FEEDER_ARM_SECONDS=25
# Hard timeout (seconds) for LIVE nonce/send RPC — avoid 30s hangs.
# MORPHO_LIVE_RPC_TIMEOUT=4
# Base routers (Uni V3 SwapRouter02 + Aerodrome). Leave empty for defaults.
# MORPHO_ROUTERS=0x2626664c2603336E57b271c5c0d842f2875A7dA0,0x2626664c2603336E57B271c5C0b26F421741e481,0xcF77a3Ba9A5CA399B7c97c74d54e5b1Beb874E43
# MORPHO_INTERMEDIATE_TOKENS=0x4200000000000000000000000000000000000006
# MORPHO_WETH=0x4200000000000000000000000000000000000006
# MORPHO_AERO_FACTORY=0x420DD381b31aEf6683db6B902084cB0FFECe40Da
# Existing PRIVATE_TX_RPC_URL is reused if you later enable live.

# Competitor recon (scripts/recon_competitors.py) — read-only, not used by the bot.
# BASE_RPC_URL=https://...           # Chainstack lax1 HTTP; else BASE_HTTP_RPC_URL
# BASESCAN_API_KEY=                  # Basescan / Etherscan v2 key

